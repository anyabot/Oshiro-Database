{"scenes":[{"n":1,"cmds":[["bg","Name=Kassenba_Night"],["chara","Name=NoUnit"],["name",""],["text","――殿たちが巨大兜を撃退した日の夜。"],["chara","Name=Boss16"],["name","佐竹義重"],["text","……良イナ！　援軍部隊が到着次第、一斉に山狩りジャア！"],["chara","Name=Zako01_2"],["name","兜軍団"],["text","応ッ！！！"],["chara","Name=Boss16"],["name","佐竹義重"],["text","ソレマデは各々待機し、英気を養うがヨイ！　解散！"],["chara","Name=Zako01_2"],["name","兜軍団"],["text","応ッ！！！"],["chara","Name=Zako01"],["name","桃形兜"],["text","……ヤレヤレ、今日ハ無事ニ何トカ凌ゲタヨ。"],["chara","Name=Zako19"],["name","古桃形兜"],["text","オウ、オ疲レー。"],["chara","Name=Zako06"],["name","突撃式トッパイ形兜"],["text","オ疲レサンー。"],["chara","Name=Zako01"],["name","桃形兜"],["text","ハー、援軍部隊、ノンビリ来テクレナイカナァ。\n山狩リッテ面倒クサインダヨォ……。"],["chara","Name=Zako13"],["name","烏帽子形兜"],["text","ソモソモ何デ山狩リッテ話ニナッタンダッケ。"],["chara","Name=Zako06"],["name","突撃式トッパイ形兜"],["text","ドッカニ隠レテルラシイ人間ドモヲ探シ出スッテ話ダロ。\nソンデ人質ニスルトカ。"],["chara","Name=Zako13"],["name","烏帽子形兜"],["text","当テハアルノカネェ。"],["chara","Name=Zako06"],["name","突撃式トッパイ形兜"],["text","ナインジャネ？　当ノ城娘ドモガドコニ行ッタカ把握シテナイラシイシ。"],["chara","Name=Zako19"],["name","古桃形兜"],["text","ナーンダ。知ッテソウナラ吐カセリャ一発ダッタノニヨ。"],["chara","Name=Zako06"],["name","突撃式トッパイ形兜"],["text","デモ誰モドコニイルノカ知ランッテコトハ、『神隠シ』ッテ奴カ？"],["chara","Name=Zako19"],["name","古桃形兜"],["text","『髪隠シ』？\n頭ノ上ニモサモサ生エテル毛ヲ隠スノカ？"],["chara","Name=Zako01"],["name","桃形兜"],["text","カツラノ逆ダネ！"],["chara","Name=Zako06"],["name","突撃式トッパイ形兜"],["text","イヤイヤ違ェヨ。神様ノ神ナ。\n神トカガ人間ヲ攫ッタリ隠シタリスル奴ナ。"],["chara","Name=Zako01"],["name","桃形兜"],["text","エ、神様ッテ人間攫ウノ？"],["chara","Name=Zako06"],["name","突撃式トッパイ形兜"],["text","厳密ニハ、神ノ領域ニウッカリ迷イ込ンダトカ言ウラシイガ……。\n俺モ良クハ知ランヨ。"],["chara","Name=Zako19"],["name","古桃形兜"],["text","フーン……。"],["chara","Name=Zako06"],["name","突撃式トッパイ形兜"],["text","後ハ、妖怪トカモ人ヲ攫ッタリスルラシイナ。\n特ニ人間ノ子供。"],["chara","Name=Zako01"],["name","桃形兜"],["text","子供カァ。\n確カニタマニ遅クニナッテモ呑気ニ遊ンデル子トカイルヨネ。"],["chara","Name=Zako19"],["name","古桃形兜"],["text","子供ネェ。ッテコトハ城娘トカモ幼イ奴見カケタコトアルケド、\nアイツラモ攫ワレルコトアルノカネ。"],["chara","Name=Zako13"],["name","烏帽子形兜"],["text","エェ……？\n幼クタッテ仮ニモ城娘ダロ？　流石ニソレハネェンジャネェノ？"],["chara","Name=Zako19"],["name","古桃形兜"],["text","イヤ、デモ案外サ、千代城ミタイナノガ、フトシタ瞬間二\n油断トカシテ攫ワレタリシソウジャン？"],["chara","Name=Zako06"],["name","突撃式トッパイ形兜"],["text","ナマジ頭ガイイカラ過信スルッテコトカ？"],["chara","Name=Zako19"],["name","古桃形兜"],["text","ソウソウ。"],["chara","Name=Zako13"],["name","烏帽子形兜"],["text","エート、ジャア仮ニ俺ラガ千代城ヲ攫ウトシタラ……\nコンナ感ジダナァ。"],["text","マズ……。"],["chara","Name=NoUnit"],["name",""],["text","――――――――。"],["text","――――。"],["bg","Name=Forest_Night"],["chara","Name=NoUnit"],["name",""],["text","――とある森。"],["chara","ID=008 type=0"],["name","千代城"],["text","（※兜製幻想形・千代城）"],["text","……ふぅ、すっかり遅くなってしまったのじゃ。"],["face","ID=008 type=2"],["text","……にしても、夜の森は不気味じゃのう。"],["chara","Name=NoUnit"],["name",""],["text","――ガサガサッ……。"],["chara","ID=008 type=0"],["name","千代城"],["face","ID=008 type=2"],["text","ひっ……な、何じゃ？"],["chara","Name=Zako13"],["name","烏帽子形兜"],["text","今ダーーーーーーーーーーッ！！"],["chara","Name=Zako01_2"],["name","兜軍団"],["text","引ッ攫エ！\n掻ッ攫エ！\n拐カセ！！"],["chara","ID=008 type=0"],["name","千代城"],["face","ID=008 type=3"],["text","な、何じゃおぬしら！"],["face","ID=008 type=2"],["text","あっ、や、やめろ！\n何をするのじゃ！"],["chara","Name=Zako13"],["name","烏帽子形兜"],["text","ヨシ！　手足モフンジバッタシ、\n大破サセチマエバコッチノモノダー！"],["chara","Name=Zako01_2"],["name","兜軍団"],["text","引ッ攫エ！\n掻ッ攫エ！\n拐カセ！！"],["chara","ID=008 type=2"],["name","千代城"],["text","やめろ！　やめるのじゃ！"],["text","誰か！　誰か助けてくれ！\n殿！　殿ーーーーーーーーーーっ！！"],["bg","Name=Castle02"],["chara","Name=NoUnit"],["name",""],["text","――その後。"],["chara","Name=Zako13"],["name","烏帽子形兜"],["text","ヘッヘッヘ、千代城ニ酷イ事ヲシテヤッタゼ！"],["text","千代城モ今ハ俺タチノ従順ナ配下！\nサァ行ケ千代城！　殿ヲ倒セー！"],["chara","ID=008 type=0"],["name","千代城"],["face","ID=008 type=2"],["text","…………。"],["face","ID=008 type=3"],["text","分かっておる……わらわが今、兜の味方をしておるのも\nただの逆恨みじゃとは……。"],["face","ID=008 type=2"],["text","それでも……それでも、わらわはもう止まれそうにない。"],["chara","ID=008 type=1 X=50 Y=35"],["text","殿、済まない。\nわらわと共に堕ちてくれ。"]]},{"n":2,"cmds":[["bg","Name=Kassenba_Night"],["chara","Name=Zako13"],["name","烏帽子形兜"],["text","……ッテ感ジカナッテ思ッタケド、\nコレ絶対殿ガ乱入シテキソウダナ。"],["text","千代城モ大破サセラレルカ怪シイトコロダシ、\n仲間ノ城娘ドモニ見ツカラナイトモ限ラナイシ……。"],["text","マ、所詮妄想ダカラ別ニイイヨナ、失敗シテテモ。"],["chara","Name=Zako19"],["name","古桃形兜"],["text","…………。"],["chara","Name=Zako06"],["name","突撃式トッパイ形兜"],["text","…………。"],["chara","Name=Zako13"],["name","烏帽子形兜"],["text","……何ダヨ、黙リコクッチマッテ。"],["chara","Name=Zako19"],["name","古桃形兜"],["text","…………引クワ。"],["chara","Name=Zako13"],["name","烏帽子形兜"],["text","エッ。"],["chara","Name=Zako19"],["name","古桃形兜"],["text","イヤ……オ前ノ妄想チョット……カナリ……。"],["chara","Name=Zako06"],["name","突撃式トッパイ形兜"],["text","オ前、ソウイウノガ好キナノカ……。"],["chara","Name=Zako01"],["name","桃形兜"],["text","烏帽子形兜、怖イ……。（プルプル）"],["chara","Name=Zako13"],["name","烏帽子形兜"],["text","チョ、何デミンナ俺カラ距離取ルンダヨ……。\n特ニ桃形兜……。"],["chara","Name=Zako01"],["name","桃形兜"],["text","誘拐……怖イ……。\nボク、攫ワレタラ何サレチャウノ……？（プルプル）"],["chara","Name=Zako06"],["name","突撃式トッパイ形兜"],["text","ホラ、俺ノ傍ニ来イ。\nアンマリ烏帽子形兜ノ傍ニ寄ルナ。"],["chara","Name=Zako01"],["name","桃形兜"],["text","ウン……。"],["chara","Name=Zako13"],["name","烏帽子形兜"],["text","トイウカオ前ハ攫ワネーヨ！\n同ジ兜ダローガ！！"],["chara","Name=Zako19"],["name","古桃形兜"],["text","ソノ……何ダ、悩ミガアルンダッタラ\n話クライハ聞イテヤレルカラナ……。"],["chara","Name=Zako13"],["name","烏帽子形兜"],["text","セメテ俺ト視線合ワセテ言ッテクレネーカナァ！？"],["chara","Name=Zako06"],["name","突撃式トッパイ形兜"],["text","マァナンダ、ソノ、欲トイウノハ\n適度ニ発散サセナイトイケナイモノデハアルラシイカラ……。"],["chara","Name=Zako13"],["name","烏帽子形兜"],["text","オ前モオ前デ何ヲ想像シタンダヨ！？"],["text","ソリャア、俺ガ千代城ヲ攫ッタ後ニシタ、\n『半日耐久正座地獄』ハヤリスギダロウケドヨ……。"],["chara","Name=Zako19"],["name","古桃形兜"],["text","…………ハ？"],["chara","Name=Zako13"],["name","烏帽子形兜"],["text","ヘッヘッヘ、正座サセ終ワッテスグ、\n足ガピリピリノ状態デ歩カセテヤッタゼェ……。"],["chara","Name=Zako06"],["name","突撃式トッパイ形兜"],["text","…………拗ラセテンナァ。"],["chara","Name=Zako01"],["name","桃形兜"],["text","ナンダ、正座カァ。"],["text","テッキリボクニハ想像モツカナイ、極悪非道ナコトヲシタノカト思ッター。"],["chara","Name=Zako13"],["name","烏帽子形兜"],["text","イヤイヤ、何言ッテンダヨ。\n十分極悪非道ダロ？"],["chara","Name=Zako01"],["name","桃形兜"],["text","ダッテ、ボクイッパイ正座サセラレルノ慣レテルモーン。"],["chara","Name=Zako13"],["name","烏帽子形兜"],["text","オッ、言ッタナ？"],["text","ナラバ俺ト正座勝負ダ！"],["chara","Name=Zako01"],["name","桃形兜"],["text","受ケテ立ツヨ！"],["chara","Name=Zako13"],["name","烏帽子形兜"],["text","オイ、誰カ審判ヤッテクレヨ、審判！"],["chara","Name=Zako19"],["name","古桃形兜"],["text","アー、ジャア俺ヤルヨ。"],["chara","Name=Zako01"],["name","桃形兜"],["text","サー、来イ！"],["chara","Name=Zako13"],["name","烏帽子形兜"],["text","負ケネェカラナ！"],["chara","Name=Zako19"],["name","古桃形兜"],["text","デハ、開始ー。"],["chara","Name=Zako01"],["name","桃形兜"],["text","…………！"],["chara","Name=Zako13"],["name","烏帽子形兜"],["text","…………！"],["chara","Name=Zako06"],["name","突撃式トッパイ形兜"],["text","（ソモソモ俺タチ……、\n　正座シタトコロデ、脚、痺レネェダロ、ッテ言ウノハ野暮ナノカ……？）"],["chara","Name=NoUnit"],["name",""],["text","――突然の正座大会の開催に、どう反応していいのか困った突撃式トッパイ形兜。"],["text","結局、やんややんやと楽しそうに騒ぐ仲間たちの雰囲気に\n水を差すこともできず、ただ不毛な争いを眺めるだけとなったのだった。"]]}]}
Value":1,"EffectAreaType":1,"EffectTargetType":2,"EffectValue":20},{"EnchantEffectType":1023,"EffectDetailType":9,"EffectDetailValue":1,"EffectAreaType":1,"EffectTargetType":2,"EffectValue":20}]},"transform":true}]}],"special_ability":null,"general_ability":null,"before_attack":null,"moving_attack":null,"one_time_reactive":null,"transform_of":null,"transform_into":{"id":7732,"name":"真田幸村","main_class":{"class_id":200,"weapon":{"type":2,"name":"槍"},"class_ability":null,"class":{"ClassID":200,"MaxLevel":125,"Cost":5,"InitialHealth":1610,"MaxHealth":3120,"AttackType":1,"MaxTarget":1,"InitialAttack":80,"MaxAttack":270,"InitialDefense":60,"MaxDefense":230,"InitialRegeneration":10,"MaxRegeneration":35,"AttackSpeed":100,"AttackRange":200,"KiGainInterval":1350,"KiBaseFeed":12,"MoveSpeedToBuilding":500,"WeaponType":2,"DefaultWeaponID":2000,"AttackWait":900,"PotentialAbilityID":200,"KiFeedLocationPlaceable":1}}},"dedicated_weapon":null,"max_renovation":0,"voice_actor":"南條愛乃","flavor":["真田家の家紋「六文銭」は、 \nその意味も含め、だいぶ有名に \nなっているようだね。やくもさ \nんからは、六文あれば団子が買 \nえるのに、もったいないって \n怒られましたよ。","真田丸とは、会うたびに大坂の \n陣の話になるな。あの悔しさを \n分かち合える仲間として、友と \nして、君は僕にとって、掛け替 \nえのない城娘だよ。","先ほど江戸城殿とお会いしまし \nたが、僕の持ってる懐刀を、ひ \nどく警戒している様子でした。 \nこれを徳川殺しの妖刀村正だ \nと、勘違いしたのかも知れない \nですね。"],"introduction":"有り難いことに、真田幸村という名前は、 \n戦国を代表する名将として知られている。 \nだけど「信繁」というのが僕の本来の名で、 \n幸村を名乗っていた証拠は、実はほとんどないんだ。 \n\nそれに僕は初陣が遅く、 \n戦にも数えるほどしか出ていない。 \nそれなのに「日の本一の兵」だなんて、 \n身に余る評価を受けているのは、 \n大坂の陣の印象が強いからなのだろう。 \n結果的には豊臣家を滅亡させた、 \n悔いの残る負け戦だったというのにね。","welcome":"僕は真田幸村。今後ともよろしく……え？ \n君が僕の新しい主君！？　こ、これは失礼を！ \nなんだか今度のお屋形さまは妙に親しみやすく、 \n同齢の朋輩のような気安さがあったもので、つい。","raw":{"CardID":7731,"ClassID":200,"Rarity":7,"CardCategory":5,"VoiceID":4018,"AreaType":4,"FavoriteThings":1,"DotScale":1.0,"HealthCorrection":119,"AttackCorrection":124,"DefenseCorrection":117,"RegenerationCorrection":100,"GrowUpID":16,"GrowUpLimitType":1001,"AbilityID":7731,"OrganizedAbilityID":7731,"AlwaysAbilityID":7731,"GimmickID":7731,"CutInYCorrection":-200,"ExclusionVote":1,"Depende
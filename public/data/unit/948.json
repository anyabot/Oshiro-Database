し、財務管理を任されておりました。 \n殿の傘下となりました暁には、質素倹約の具申をさせて \n頂きたく……財政とは、日々の積み重ねの結果ですから。","raw":{"CardID":948,"ClassID":500,"DedicatedWeaponID":14028,"Rarity":6,"Tokusei1":28,"VoiceID":937,"AreaType":2,"DotScale":1.0,"HealthCorrection":100,"AttackCorrection":135,"DefenseCorrection":113,"RegenerationCorrection":100,"GrowUpID":1,"GrowUpLimitType":999,"AbilityID":9948,"AlwaysAbilityID":948,"GimmickID":948,"SpecialAbilityID":948,"CutInYCorrection":-200,"MaxRenovationCount":1,"RenovationType":2,"Renovation1GimmickID":9948,"DependenceCardId":6948,"AutoProtect":1}}
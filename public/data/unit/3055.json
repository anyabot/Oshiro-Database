ityType":1,"AbilityAreaType":1,"AbilityTargetType":2,"StatusModifierType":21,"EffectValue":66},{"AbilityType":1,"AbilityAreaType":1,"AbilityTargetType":2,"StatusModifierType":66,"EffectValue":30},{"AbilityType":1,"AbilityAreaType":1,"AbilityTargetType":2,"StatusModifierType":91,"EffectValue":600},{"AbilityType":1,"AbilityAreaType":1,"AbilityTargetType":2,"StatusModifierType":41,"EffectValue":99}]}}}],"special_ability":null,"general_ability":null,"before_attack":null,"moving_attack":null,"one_time_reactive":null,"transform_of":null,"transform_into":null,"dedicated_weapon":null,"max_renovation":1,"voice_actor":"森なな子","flavor":["アイドルの肥前名護屋城さん、\n金髪が奇麗で我欲があるから\nお気に入りなの。でも、海を\n越えて冒険に出てみたらって\n提案したら、\n渋い顔されちゃったわ。","私は黄金が大好きだけど、他の\n黄金好きの人とは、少しベクト\nルが違うかもしれないわね。\nエル・ドラードにおける黄金は\n草木のように馴染み深い存在。\n特別でないから好きなのよ。","良い匂いがする、ですって？\n可愛らしい褒め方をするのね。\nこれは黄金の匂い――じゃなく\nてシナモンの香りよ。昔はとて\nも高価だった香辛料で、黄金郷\nに自生すると夢見られてたわ。"],"introduction":"エル・ドラードは、南米大陸の密林の奥地に\nあると言われた黄金郷よ。そこに在るのは、掃いて\n捨てるほどの黄金の山。都市を統べる王は、\n素肌に金粉を纏って暮らしていたと言われるわ。\n\n海賊まがいの冒険家から大国の女王の寵臣まで、\n様々な人間が私財を投げうって黄金郷発見に挑み、\nそして厄災に遭っては破滅していったの。\n\n欲望にその身を食い潰された愚か者たち……。\nされど彼らの欲望は、人類史の歩みを大いに\n進めた原動力でもあると、私は思うのよ。","welcome":"飽くるほどの黄金に満ちた秘境にして、\nそれを求める者すべてを破滅させる魔境――。\nそれが私、黄金郷エル・ドラードよ。\nひょっとして、貴方も私のことが欲しいの？","raw":{"CardID":3055,"ClassID":700,"Rarity":7,"Tokusei1":20,"VoiceID":976,"AreaType":13,"DotScale":1.0,"HealthCorrection":104,"AttackCorrection":144,"DefenseCorrection":112,"RegenerationCorrection":100,"GrowUpID":3,"GrowUpLimitType":999,"AbilityID":93055,"OrganizedAbilityID":3055,"GimmickID":3055,"SpecialAttackID":3055,"CutInYCorrection":-200,"MaxRenovationCount":1,"RenovationType":5,"Renovation1AbilityID":94055,"Renovation1GimmickID":4055,"Renovation1SpecialAttackID":4055,"AutoProtect":1}}
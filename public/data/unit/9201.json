yType":2,"AbilityAreaType":1,"AbilityTargetType":2,"StatusModifierType":3,"Passive":1,"EffectValue":50,"DurationInMillis":5000},{"AbilityType":2,"AbilityAreaType":1,"AbilityTargetType":2,"StatusModifierType":53,"Passive":1,"EffectValue":50,"DurationInMillis":5000},{"AbilityType":1,"AbilityAreaType":3,"AbilityTargetType":501,"StatusModifierType":2,"Passive":1,"EffectValue":300},{"AbilityType":1,"AbilityAreaType":3,"AbilityTargetType":501,"StatusModifierType":52,"Passive":1,"EffectValue":60},{"AbilityType":1,"AbilityAreaType":1,"AbilityTargetType":2,"StatusModifierType":41,"Passive":1,"EffectValue":2}]}},"dedicated_weapon":{"id":99201,"name":"五稜郭の鉄砲(固定)","description":""},"max_renovation":0,"voice_actor":"松田利冴","flavor":["C'est la vie…… \n『人生はこういうものさ』 \nといった意味合いの言葉です。 \n事象に振り回されず、 \n冷静に状況を見据える……良い \n慣用句だと、思いませんか？","城娘の五稜郭さんは……熱血 \n応援団長、でした。同じ名を \n冠してここまで異質とは…… \nでも、星形に担う……筋を \n通した、譲れない意志は同じ。 \n今では、良き相互理解者です。","こちらの日の本では、 \n魑魅魍魎ではなく、 \n兜が敵性体だと聞きました。 \nC'est la vie……兜にも、 \n私の十字砲火が通用するか…… \n早速、試してみましょうか？"],"introduction":"五稜郭、五芒星型要塞の城姫です。 \n\n城姫、というのは……ヒノモトの国において、 \n城主様と共に黒き力に侵された魑魅魍魎達と戦い、 \nそれを解放する存在……お殿様と城娘の関係に、 \n似ているところもあるでしょうか？ \n\n落ち着いている、ですか。 \n焦っても仕方ありませんし、冷静に \n元の世界へ戻る方法を探るより他はないので…… \nC'est la vie。 \n何が起るか分からない、 \nこれが、人生というものですから。","welcome":"蝦夷地箱館、稜堡式城郭の五稜郭と申します。 \n貴方が城娘を束ねる、お殿様、でしょうか。 \nヒノモトと日の本、城姫と城娘…… \n中々、興味深いですね……C'est la vie。","raw":{"CardID":9201,"ClassID":99201,"DedicatedWeaponID":99201,"Rarity":7,"CardCategory":17,"ChangeEstateType":1,"VoiceID":9201,"AreaType":1,"GainableYakumodama":200,"FavoriteThings":-1,"DotScale":1.0,"HealthCorrection":140,"AttackCorrection":140,"DefenseCorrection":140,"RegenerationCorrection":100,"GrowUpID":1,"AbilityID":99201,"GimmickID":99201,"SpecialAbilityID":99201,"CutInYCorrection":-200,"ExclusionVote":1,"DependenceCardId":9204,"AutoProtect":1,"Sequence":500}}
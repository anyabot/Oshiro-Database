ilityType":6,"AbilityTypeDetail":14,"AbilityAreaType":1,"AbilityTargetType":310,"AbilityLocationType":9,"Passive":1,"EffectValue":6381312},{"AbilityType":1,"AbilityAreaType":1,"AbilityTargetType":2,"AbilityLocationType":9,"StatusModifierType":6,"Passive":1,"EffectValue":20},{"AbilityType":1,"AbilityAreaType":1,"AbilityTargetType":2,"AbilityLocationType":9,"StatusModifierType":107,"Passive":1,"EffectValue":20},{"AbilityType":1,"AbilityAreaType":1,"AbilityTargetType":2,"AbilityLocationType":9,"StatusModifierType":214,"Passive":1,"EffectValue":20},{"AbilityType":1,"AbilityAreaType":1,"AbilityTargetType":2,"AbilityLocationType":9,"StatusModifierType":10216,"Passive":1,"EffectValue":10},{"AbilityType":1,"AbilityAreaType":2,"AbilityTargetType":36,"StatusModifierType":6,"Passive":1,"EffectValue":5},{"AbilityType":1,"AbilityAreaType":2,"AbilityTargetType":36,"StatusModifierType":107,"Passive":1,"EffectValue":5},{"AbilityType":1,"AbilityAreaType":2,"AbilityTargetType":36,"StatusModifierType":202,"Passive":1,"EffectValue":30},{"AbilityType":1,"AbilityAreaType":2,"AbilityTargetType":311,"StatusModifierType":6,"Passive":1,"EffectValue":5},{"AbilityType":1,"AbilityAreaType":2,"AbilityTargetType":311,"StatusModifierType":107,"Passive":1,"EffectValue":5},{"AbilityType":1,"AbilityAreaType":2,"AbilityTargetType":311,"StatusModifierType":202,"Passive":1,"EffectValue":30}]},"before_attack":null,"moving_attack":null,"one_time_reactive":{"Wait":60000,"ConsumeKiRatio":300,"ActivateSE":9437308,"ActivateVoice":10},"transform_of":null,"transform_into":null,"dedicated_weapon":{"id":13031,"name":"太陽の機杖(固定)","description":""},"max_renovation":1,"voice_actor":"平田真菜","flavor":["コロちゃんは、既に世界の七不\n思議。でも、もっと不思議で凄\nい伝説、増やしてみたいな。飛\n行形態に、ロケットパンチ\n……あ。他の七不思議と、変形\n合体する機能とか、どう？","ぷしゅー……張りつめていた神\n経の、弛緩を確認。\nリンドス・アクロポリスの淹れ\nるハーブティ、やっぱり好き。\nこれで午後からの見回りも、頑\n張れる。ぶいぶい、しゅごごご。","ばしーん、びたーん！　ああ、\nこれ？　エーゲ海の蛸は、\n筋が多くて硬いから。こうして、\n料理する前に、石床へ叩きつけ\nるのよ。それ、もーいっちょ。\nばしーん、ずばびたーん！"],"introduction":"ぴぴっ、しゅごぉー！\n新しい市長さんを確認、相互認証の要を認む。\n\nろーは、ロードス。\n難攻不落と謳われた、\nロードス島の城塞都市、ロードス。\nこの子は、コロちゃん。\n包囲戦の戦勝を祝って建造された、\n太陽神ヘーリオスの巨像。\n街の守護神にして、世界七不思議のひとつ。\n巨大な彫像《コロッソス》だから、コロちゃん。\n\nろーとコロちゃんが居るところ、即ち、ロードス島。\n島も、街も、人も、保護対象。\nもちろん、市長さんも……ね？","welcome":"がしょーん、がしょーん……ずしぃーん！ \nろーは、ロードス。城塞都市ロードス。 \n太陽神の巨像と共に、あなたの島と街を護る、防衛機構。 \nふふ、この子のことは、コロちゃんって、呼んでね。","raw":{"CardID":3097,"ClassID":10800,"DedicatedWeaponID":13031,"Rarity":7,"Tokusei1":23,"Tokusei2":32,"VoiceID":1017,"AreaType":12,"FavoriteThings":1,"DotScale":1.0,"HealthCorrection":107,"AttackCorrection":145,"DefenseCorrection":108,"RegenerationCorrection":100,"GrowUpID":5,"GrowUpLimitType":999,"AbilityID":93097,"GeneralAbilityID1":100500,"GimmickID":3097,"OneTimeEffectReactiveType":1,"CutInYCorrection":-200,"MaxRenovationCount":1,"RenovationType":5,"Renovation1AbilityID":94097,"Renovation1GimmickID":4097,"AutoProtect":1}}
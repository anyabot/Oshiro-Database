ategyID":-1,"AllyModifierType1":51,"AllyEffectValue1":20,"AllyEffectSetID":680,"OpponentEffectSetID":679},"AllyEffectSetID":[{"EnchantEffectType":1410,"EffectAreaType":2,"EffectTargetType":15,"EffectValue":15},{"EnchantEffectType":1414,"EffectAreaType":2,"EffectTargetType":15,"EffectValue":15}],"OpponentEffectSetID":[{"EnchantEffectType":3016,"EffectAreaType":2,"EffectTargetType":42,"EffectValue":50}]},"set_member":true}]}],"special_ability":null,"general_ability":null,"before_attack":null,"moving_attack":null,"one_time_reactive":null,"transform_of":null,"transform_into":null,"dedicated_weapon":null,"max_renovation":1,"voice_actor":"日笠陽子","flavor":["法螺貝を持ち歩いていると、\n試しに吹いてみてと、\n言われることがあるんですぅ。\nお見せしたいのはやまやま\nですが、人前だと緊張して\nしまって……うぅ。","あのぅ……お殿さまは、\n何か好きな物語はありますか？\nえっと、わたしも物語が好きで\n……もし趣味が合えば、\nお殿さまを楽しませられる\nのではと思いまして……！","廊下にいた大きな百足さんを\n退治したら、城娘さんたちに\nありがとうって言われちゃい\nました……えへへ。わたし、\n百足さんや虫さんには\n滅法強いんですよぉ。"],"introduction":"わたし下館城は、常陸国の御城。\n文明十年に水谷勝氏さまが結城氏広さまから\n下館領を与えられて築城したのが始まりです。\n\n本丸が三重の水堀に囲まれているのが特徴で、\nその構造から『法螺貝城』とも言われています。\n普段は貝の奥……本丸に籠もって物語を読んだり\n法螺貝を吹いたりして過ごしてます。\n\nお陰で、人と接することに臆病に\nなってしまったのですが……。\nご迷惑をお掛けしないよう、努力します……。","welcome":"初めまして。わたしは下館城と申しま――ひぇっ！？\nご、ごめんなさい……外の音に驚いてしまいました。\nやっぱりお堀の外は怖いよぉ……。","raw":{"CardID":832,"ClassID":1000,"Rarity":5,"VoiceID":742,"AreaType":3,"GainableYakumodama":20,"FavoriteThings":2,"DotScale":1.0,"HealthCorrection":112,"AttackCorrection":112,"DefenseCorrection":112,"RegenerationCorrection":100,"GrowUpID":3,"GrowUpLimitType":999,"AbilityID":9832,"GimmickID":832,"CutInYCorrection":-200,"MaxRenovationCount":1,"Renovation1AbilityID":10832,"Renovation1GimmickID":9832}}
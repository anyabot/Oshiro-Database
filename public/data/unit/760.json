e":91,"EffectValue":50},{"AbilityType":3,"AbilityTypeDetail":7,"AbilityAreaType":2,"AbilityTargetType":4,"EffectValue":20},{"AbilityType":1,"AbilityAreaType":2,"AbilityTargetType":4,"StatusModifierType":103,"EffectValue":35}]},"stratagems":[{"id":9760,"name":"黒船襲来","description":"35秒間対象の射程内の海外城娘の攻撃が1.7倍\n射程内の敵の移動速度と射程が40%低下\n(軍船城娘が対象)","ki":7,"cooldown":50,"stock":null,"guide":"任意の味方を強化する","raw":{"GimmickPoint":50,"Ki":7,"FaceIconID":760,"GimmickIconID":1179654,"GimmickType":1,"EffectID":574,"GuideTextID":101,"GimmickAutoActivate":1},"effect":{"id":574,"row":{"DurationInSeconds":35.0,"TargetType":111,"StartEffect":6358528,"ActiveEffect":6359808,"TargetStrategyID":-1,"AttackStrategyID":-1,"AllyEffectSetID":570,"OpponentAreaType":2,"OpponentModifierType1":301,"OpponentEffectValue1":40,"OpponentModifierType2":53,"OpponentEffectValue2":40},"AllyEffectSetID":[{"EnchantEffectType":1011,"EffectAreaType":2,"EffectTargetType":612,"EffectValue":70}]}}]}],"special_ability":null,"general_ability":null,"before_attack":null,"moving_attack":null,"one_time_reactive":null,"transform_of":null,"transform_into":null,"dedicated_weapon":null,"max_renovation":1,"voice_actor":"生天目仁美","flavor":["わたしの名は祖国の\nペンシルバニアを流れる\nサスケハナ川に由来する。\n『広く深い川』という意味を\n持ち、古来より現地の\n人々に親しまれてきたのだ。","少しずつ、日の本の城娘たち\nとも打ち解けてきた。\nだが……寛永江戸城は\nまだわたしのことを警戒して\nいる様子……。まったく、\n外交とは厄介なものだな。","わたしの船体の黒さは、\nピッチという樹脂によるもの。\n怯えるのはそちらの勝手だが、\n防水を目的としたものに\n過ぎないので、\n気にしないように。"],"introduction":"サスケハナ号は\n東インド艦隊の旗艦として造りあげられ、\n祖国アメリカと日の本の国交を結ぶために尽力した。\n\n『黒船』という通称には、聞き覚えがあるだろう？\nマシュー・ペリー代将を主として、\n各国の港に立ち寄りながら\n日の本へと向かった航路は、\n数ヶ月にも及ぶ過酷な旅路となった。\n\n貴様と肩を並べて戦うことには、\n思うところもあるが……これも和親のためだ。\n目的を一にする限りは、\nこちらを信用してもらわねば困るぞ。","welcome":"サスケハナ号、着任する。\n海が荒れようが、遥か遠くの島国だろうが構うことはない。\n日の本と祖国の和親のためなら、どこへでも行こう。","raw":{"CardID":760,"ClassID":1200,"Rarity":7,"VoiceID":735,"AreaType":12,"DotScale":1.0,"HealthCorrection":110,"AttackCorrection":134,"DefenseCorrection":116,"RegenerationCorrection":100,"GrowUpID":4,"GrowUpLimitType":999,"AbilityID":9760,"Gimmick
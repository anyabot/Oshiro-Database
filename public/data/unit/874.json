:5,"cooldown":45,"stock":null,"guide":"自分を強化する","raw":{"GimmickPoint":45,"Ki":5,"FaceIconID":874,"GimmickIconID":1179673,"GimmickType":1,"EffectID":748,"GuideTextID":102,"GimmickAutoActivate":1},"effect":{"id":748,"row":{"DurationInSeconds":30.0,"TargetType":2,"StartEffect":6358528,"ActiveEffect":6359808,"IndicatorPattern":1,"TargetStrategyID":-1,"AttackStrategyID":-1,"AllyEffectSetID":748},"AllyEffectSetID":[{"EnchantEffectType":3019,"EffectAreaType":1,"EffectTargetType":2,"EffectValue":100},{"EnchantEffectType":7002,"EffectDuration":1000,"EffectAreaType":1,"EffectTargetType":2},{"EnchantEffectType":1021,"EffectAreaType":1,"EffectTargetType":2,"EffectValue":100},{"EnchantEffectType":1021,"EffectAreaType":2,"EffectTargetType":11,"EffectValue":80}]},"set_member":true}]}],"special_ability":null,"general_ability":null,"before_attack":null,"moving_attack":null,"one_time_reactive":null,"transform_of":null,"transform_into":null,"dedicated_weapon":null,"max_renovation":1,"voice_actor":"ゆきのさつき","flavor":["お正月といえば八坂のかるた始\nめに六波羅の皇服茶、それにそ\nれに……え、これらは京独自の\n文化、なのですか。ではまさか\n初詣も……あら、こちらは\n日の本共通？　良かったぁ♪","大宰府さんから届いた腹赤の魚\nはよし、と――わわっ平城京\nさん！？も、もちろん元日節会\nの準備は滞りなく……氷様の\n手配？あ、いえその、今やろう\nと思っていたところで～す！","姉三六角、蛸錦～♪実は私、\n年の瀬で賑わう市に出掛けるの\nが密かな楽しみなんです。特に\n錦は、幼い頃から京の台所とし\nて親しんでいまして。お殿さま\nもご一緒に、如何ですか？"],"introduction":"京の都の年末年始は、\n師走から文字通り大忙しなんです。\n終い弘法に終い天神、お煤払いから除夜の鐘……\nそして年が明ければ、\n都中の寺社仏閣が初詣で大賑わい。\n\nけれど、そんな活気あふれる\nお正月を過ごせる日々というのは……\n私の歴史の中では、\n決して当然のものではありませんでした。\n\n貴方さまと共に、安らかな都を\n次の千年まで永らえさせるためにも。\nふふ……早速、数多の由緒ある名刹へ、\n初詣と参りましょうか♪","welcome":"謹んで新春の御祝詞を申し上げます、お殿さま。\n一年の計は元旦にあり、千年の都もまずは\nひととせから……。万代宮と共に歩む貴方さまの年始めが、\nどうか平らかなものでありますように。","raw":{"CardID":874,"ClassID":200,"Rarity":7,"Tokusei1":6,"SkinGroupID":218,"VoiceID":861,"AreaType":7,"FavoriteThings":2,"DotScale":1.0,"HealthCorrection":130,"AttackCorrection":130,"DefenseCorrection":100,"RegenerationCorrection":100,"GrowUpID":1,"GrowUpLimitType":999,"AbilityID":9874,"GimmickID":874,"CutInYCorrection":-200,"MaxRenovationCount":1,"Renovation
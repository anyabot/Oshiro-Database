Type":4,"FavoriteThings":2,"DotScale":1.0,"HealthCorrection":120,"AttackCorrection":120,"DefenseCorrection":120,"RegenerationCorrection":100,"GrowUpID":16,"GrowUpLimitType":1001,"AbilityID":7739,"OrganizedAbilityID":7739,"AlwaysAbilityID":7739,"GimmickID":7739,"SpecialAttackID":7739,"SpecialAbilityID":7739,"CutInYCorrection":-200,"ExclusionVote":1,"DependenceCardId":7740,"AutoProtect":1,"Sequence":300}}
neTextureID":5636126},"ability":{"id":7238,"name":"治癒の湧泉","description":"射程内の殿と城娘全てに回復を行う\n状態異常を回復し､10秒間全ての状態異常を無効化\n(回復射程:2.2倍)","effects":[{"AbilityType":1,"AbilityAreaType":1,"AbilityTargetType":2,"StatusModifierType":21,"EffectValue":129},{"AbilityType":1,"AbilityAreaType":1,"AbilityTargetType":2,"StatusModifierType":66,"EffectValue":120}]}}}],"special_ability":null,"general_ability":null,"before_attack":null,"moving_attack":null,"one_time_reactive":null,"transform_of":null,"transform_into":null,"dedicated_weapon":null,"max_renovation":1,"voice_actor":"上田麗奈","flavor":["ハンガリーの温泉の歴史は古く、\n1世紀ごろにローマの属州で\nあったころに遡ります。ローマ\nのように市民の社交場で\nある一方で、兵たちの療養所と\nしても発展いたしました。","16世紀ごろになるとオスマント\nルコの影響下でトルコ式の温泉\nが流行いたしました。\n『ハマム』がその代表的な例で、\nじっくりと美容と健康のため\n身体を温めていたんですね。","ハンガリーの温泉では浴衣を身\nに着けてください！　日の本式\nのお風呂もあるにはありますが\n……こ、ここは、わたくしたち\nにとって慣れた姿で\nよろしくおねがいいたします。"],"introduction":"わたくし、ブダ城が佇むハンガリーは、\n古来よりローマ帝国の影響下で\n温泉文化が発達してきました。\n運動場などを備えたローマ式風呂は、\n健康のみならず\n社交場としての機能も持ち合わせています。\n\nやがてオスマントルコの影響下で\n第二次温泉ブームが沸き起こります。\n\n『ハマム』を中心とした汗を流す入浴法により、\n新陳代謝を促す美容効果が促進されました。\n\nぬるめのお風呂でゆっくりと語り合いましょうね♪","welcome":"世界有数の温泉大国ハンガリーへようこそ♪\nローマ、オスマントルコと、偉大なる温泉文化を持つ国々の\n影響をうけた、めくるめく温泉郷へ――\n案内人はもちろん、このブダ城です。よろしくお願いします♪","raw":{"CardID":3074,"ClassID":900,"Rarity":7,"Tokusei1":31,"SkinGroupID":279,"VoiceID":943,"AreaType":12,"DotScale":1.0,"HealthCorrection":132,"AttackCorrection":110,"DefenseCorrection":118,"RegenerationCorrection":100,"GrowUpID":1,"GrowUpLimitType":999,"AbilityID":93074,"GimmickID":3074,"SpecialAttackID":3074,"CutInYCorrection":-200,"MaxRenovationCount":1,"RenovationType":7,"Renovation1AbilityID":94074,"Renovation1GimmickID":4074,"Renovation1SpecialAttackID":4074,"ExclusionVote":1,"AutoProtect":1}}
effects":[{"AbilityType":1,"AbilityAreaType":3,"AbilityTargetType":811,"StatusModifierType":1,"EffectValue":35},{"AbilityType":1,"AbilityAreaType":3,"AbilityTargetType":12,"StatusModifierType":1,"EffectValue":35},{"AbilityType":1,"AbilityAreaType":3,"AbilityTargetType":811,"StatusModifierType":71,"EffectValue":30},{"AbilityType":1,"AbilityAreaType":3,"AbilityTargetType":12,"StatusModifierType":71,"EffectValue":30},{"AbilityType":22,"AbilityTypeDetail":10,"AbilityAreaType":2,"AbilityTargetType":2,"EffectValue":120},{"AbilityType":1,"AbilityAreaType":2,"AbilityTargetType":2,"StatusModifierType":61,"EffectValue":20}]}},"dedicated_weapon":{"id":14029,"name":"愛輪拳(固定)","description":""},"max_renovation":1,"voice_actor":"南條愛乃","flavor":["バレンタインと我が国の「情人節」 \nでは、風習が若干異なるようだな。 \n中国のバレンタインは恋人同士で \n過ごすための日で、男から女に贈 \nり物をするのが一般的なのだぞ。","せっかくのバレンタインなのに、 \n想い人に気持ちを伝える勇気の \n出ない女子のなんと多いこと \nか！　よし。ここは我が一肌脱 \nごうではないか！","日の本には友チョコなる風習が \nあると聞き、我も万里の長城の \n為に用意してみたのだ。喜んで \nくれると嬉しいが……何？　羨 \nましい？　王には大量の本命チ \nョコが届くだろうに。こやつめ。"],"introduction":"不夜城は中国の古代都市。 \n古代などと漠然と言っているが、 \n我の名は漢書にも記されているので、 \n二千年以上前から存在していたことになる。 \n\nバレンタインに近い祭りである元宵節も、 \n既にその頃からあったらしいぞ。 \n元宵節では、当時は禁忌とされた \n女性の夜半の外出も認められていたので、 \n若い男女の絶好の出会いの場となっていたのだ。 \n\nだから、その日はきっと、まさに国全体が \n眠らない夜となっていたであろうなぁ。","welcome":"バレンタインなる催事に備え、チョコ作りを会得したぞ。 \n徹夜で特訓したのだが、夜を知らぬ我には造作もない。 \nして、我の自慢の手作りチョコレート、 \n王も欲しいか？　ん？　ん？","raw":{"CardID":3003,"ClassID":500,"DedicatedWeaponID":14029,"Rarity":7,"Tokusei1":26,"Tokusei2":22,"Tokusei3":11,"SkinGroupID":262,"VoiceID":961,"AreaType":12,"DotScale":1.0,"HealthCorrection":110,"AttackCorrection":140,"DefenseCorrection":110,"RegenerationCorrection":100,"GrowUpID":5,"GrowUpLimitType":999,"AbilityID":93003,"OrganizedAbilityID":3003,"GeneralAbilityID1":100025,"GimmickID":3003,"CutInYCorrection":-200,"MaxRenovationCount":1,"RenovationType":5,"Renovation1AbilityID":94003,"Renovation1GimmickID":4003,"ExclusionVote":1,"DependenceCardId":16003,"AutoProtect":1}}
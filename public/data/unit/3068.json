eaType":2,"AbilityTargetType":36,"StatusModifierType":6,"Passive":1,"EffectValue":5},{"AbilityType":1,"AbilityAreaType":2,"AbilityTargetType":36,"StatusModifierType":107,"Passive":1,"EffectValue":5},{"AbilityType":1,"AbilityAreaType":2,"AbilityTargetType":36,"StatusModifierType":202,"Passive":1,"EffectValue":30},{"AbilityType":1,"AbilityAreaType":2,"AbilityTargetType":311,"StatusModifierType":6,"Passive":1,"EffectValue":5},{"AbilityType":1,"AbilityAreaType":2,"AbilityTargetType":311,"StatusModifierType":107,"Passive":1,"EffectValue":5},{"AbilityType":1,"AbilityAreaType":2,"AbilityTargetType":311,"StatusModifierType":202,"Passive":1,"EffectValue":30}]},"before_attack":null,"moving_attack":null,"one_time_reactive":null,"transform_of":null,"transform_into":null,"dedicated_weapon":{"id":17031,"name":"海軍割烹術書(固定)","description":""},"max_renovation":1,"voice_actor":"中村桜","flavor":["日本海海戦を制した、東郷閣下\nの連合艦隊。その旗艦を務めた\n三笠さんの母港は、私なんです\nよ。ふふ、あの子も随分と立派\nになって。鎮守府として、\n鼻が高い卒業生です。","海上演習に商船整理、軍船寮の\n炊事洗濯その他諸々！忙しいぃ、\nでもやりきるのです舞鶴港！\n全てを終えれば大漁旗が、舞鶴\n湾の豊かな海の幸が！\n私を待っているのだからぁあ！","舞鶴城と渾名される城娘は多い、\nですか。それは確かに、紛らわ\nしいですねぇ……あの、司令長\n官殿？　私は、本名なんですけ\nど……ほ、本当ですって！ \n信じてくださぁい！"],"introduction":"古来より良港として発展してきた舞鶴港は、\nロシア帝国の脅威に対抗するため、東港を中心に、\n日本海側唯一の鎮守府として制定されました。\nとはいえ、武骨なだけではありませんよ？\n\n赤レンガ造りの美しい倉庫群に、\n海軍仕込みの洋食文化など、\nモダンな雰囲気の街も自慢なんです。\n\nあ、これですか？\n今朝、西港で獲ってきた京鰆です♪\nお近づきの印にと思って、よいしょっと。\nさっそく捌いて、ソテーにしちゃいましょうね。\n――せいやっ！","welcome":"お初にお目にかかります、司令長官殿。 \n私は舞鶴、日の本における近代海軍の拠点として、 \n鎮守府が置かれた軍港です。赤レンガを吹き抜ける \nモダンの風で、貴下の艦隊に規律と勝利をもたらしましょう。","raw":{"CardID":3068,"ClassID":11000,"DedicatedWeaponID":17031,"Rarity":7,"Tokusei1":32,"VoiceID":1019,"AreaType":7,"FavoriteThings":1,"DotScale":1.0,"HealthCorrection":110,"AttackCorrection":142,"DefenseCorrection":108,"RegenerationCorrection":100,"GrowUpID":4,"GrowUpLimitType":999,"AbilityID":93068,"OrganizedAbilityID":3068,"GeneralAbilityID1":100500,"GimmickID":3068,"SpecialAttackID":3068,"CutInYCorrection":-200,"MaxRenovationCount":1,"RenovationType":5,"Renovation1Abili
":4,"StatusModifierType":3,"EachGrowUp":1,"EffectValue":8},{"AbilityType":1,"AbilityAreaType":2,"AbilityTargetType":4,"StatusModifierType":103,"EachGrowUp":1,"EffectValue":8},{"AbilityType":1,"AbilityAreaType":2,"AbilityTargetType":4,"StatusModifierType":301,"EachGrowUp":1,"EffectValue":8},{"AbilityType":8,"AbilityTypeDetail":2,"AbilityAreaType":2,"AbilityTargetType":4,"EachGrowUp":1,"EffectValue":8},{"AbilityType":3,"AbilityTypeDetail":7,"AbilityAreaType":2,"AbilityTargetType":4,"EachGrowUp":1,"EffectValue":14}]}},"dedicated_weapon":{"id":12032,"name":"華宴の燦鈴(固定)","description":""},"max_renovation":1,"voice_actor":"堀江由衣","flavor":["聚楽第は……栄華の象徴である\n一方で、汚名と共に破壊された\n……不遇の証でもありました。\n私はずっと……その印象を\n払いたかった……。今の私は、\n元気と笑顔の聚楽第です。","歌もお茶も、もちろん武芸も、\n今でも全て……それなりに達者\nにこなせます。けれど……今\n一番得意なのは、鈴を使った\n音曲かもしれません……\nしゃららーん。","戦場における、私の役割も\n変わったと思い……得物を弓か\nら、華やかな鈴へと持ち替えま\nした。ふふ、ご安心ください。\n戦では……以前とは異なる形で、\n貢献いたしますので。"],"introduction":"長生不老の楽を聚むる第……。\nそれが……聚楽第の名の由来です。\n\n秀吉様により、壮大華麗に建てられた私は、\n栄華の象徴として称えられました。\nしかし……私を譲り受けた、\n甥の秀次様にかけられた謀反の汚名により、\n見せつけのように破壊され、\n一転私は、反逆の象徴となりました……。\n\nけれど、私は決して豊臣の夢の跡ではありません。\n楽を聚め、みんなが笑える第となるよう、\n精進してまいりました……。\nお殿様……生まれ変わったこの聚楽第も、\nどうぞよろしくお願いします……。","welcome":"楽が聚まる第と書いて聚楽第……。\nその名に恥じぬ城娘にならんがため、\n今日まで精進を続け……この境地に至りました。\nお殿様……褒めて、いただけますか？","raw":{"CardID":3105,"ClassID":10700,"DedicatedWeaponID":12032,"Rarity":7,"Tokusei1":28,"VoiceID":1063,"AreaType":7,"DotScale":1.0,"HealthCorrection":118,"AttackCorrection":125,"DefenseCorrection":117,"RegenerationCorrection":100,"GrowUpID":1,"GrowUpLimitType":999,"AbilityID":93105,"OrganizedAbilityID":3105,"AlwaysAbilityID":3105,"GimmickID":3105,"SpecialAbilityID":3105,"CutInYCorrection":-200,"MaxRenovationCount":1,"RenovationType":4,"Renovation1AbilityID":94105,"Renovation1GimmickID":4105,"DependenceCardId":16105,"AutoProtect":1}}
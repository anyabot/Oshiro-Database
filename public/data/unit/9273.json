……じゃなくて、\n新隊長の逸見エリカよ。\n西住隊長から受け継いだ黒森峰の戦車道、\nこの日の本でも存分に見せてあげるわ。","raw":{"CardID":9273,"ClassID":99273,"DedicatedWeaponID":99273,"Rarity":7,"CardCategory":19,"ChangeEstateType":1,"VoiceID":9273,"AreaType":14,"FavoriteThings":-1,"DotScale":1.0,"HealthCorrection":140,"AttackCorrection":140,"DefenseCorrection":140,"RegenerationCorrection":100,"GrowUpID":16,"AbilityID":99273,"GimmickID":99273,"SpecialAttackID":99273,"SpecialAbilityID":99273,"CutInYCorrection":-200,"ExclusionVote":1,"DependenceCardId":9277,"AutoProtect":1,"Sequence":500}}
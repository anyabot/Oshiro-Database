usModifierType":131,"Passive":1,"EffectValue":1}]}},"set_member":true}]}],"special_ability":null,"general_ability":null,"before_attack":null,"moving_attack":null,"one_time_reactive":null,"transform_of":null,"transform_into":null,"dedicated_weapon":{"id":99141,"name":"刻詠の風水鏡(固定)","description":""},"max_renovation":0,"voice_actor":"たみやすともえ","flavor":["刻詠は、予言や占いの亜種に\nあらず。吾は未来を予知\nするのではない。\n厳密には既知じゃ。\n定義された事柄として、既に\n「識っている」のじゃ。","吾を脅かそうとしても、無駄\nじゃ。稚児の如き悪戯すらも、\n吾は元より承知ゆえな。すな\nわち、不意打ちの類も吾には\n通じぬ。疑心なれば、闇に乗\nじて吾を背後から襲うが善い。","刻を詠めずした事例が、実は\nある。ある特異な契機に\nよって、予め詠んでいた刻が\n不意に崩れてしまうことが\nあったのじゃ。稀なる現象とは\nいえ、あれは苦い経験じゃ。"],"introduction":"吾の歴などどうでもよかろうに。\nそうじゃな……吾はとある皇国にて、\n幼き頃から風水士として仕えてきた。\n\nしかし、吾が有した刻詠なる権能を、\n皇室も当初は神業と持て囃しながら\nいつしか傾国をもたらす驚異と見做し、\n地下深くに、吾は幽閉されたのじゃ。\n\n耐え難き苦痛の日々を、それでも耐えられたのは\nいずれ王子に救われると、識っていたからじゃな。","welcome":"名はリンネ。刻詠の風水士と呼ぶ者もいる。\n解し易く簡素に刻詠の意を説くとするなら\n未来予知と同義だとして、概ね差し支えはあるまい。\n汝の刻も詠んでやろうではないか。","raw":{"CardID":9141,"ClassID":99141,"DedicatedWeaponID":99141,"Rarity":7,"CardCategory":10,"ChangeEstateType":1,"VoiceID":9141,"AreaType":14,"GainableYakumodama":200,"FavoriteThings":-1,"DotScale":1.0,"HealthCorrection":140,"AttackCorrection":140,"DefenseCorrection":140,"RegenerationCorrection":100,"GrowUpID":16,"AbilityID":99141,"GimmickID":99141,"CutInYCorrection":-200,"ExclusionVote":1,"AutoProtect":1,"Sequence":500}}
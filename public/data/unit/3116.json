ype":502,"StatusModifierType":102,"Passive":1,"EffectValue":5,"LimitValue":200},{"AbilityType":19,"AbilityTypeDetail":3,"AbilityEffectDetail":8,"AbilityAreaType":3,"AbilityTargetType":502,"StatusModifierType":202,"Passive":1,"EffectValue":3,"LimitValue":25},{"AbilityType":1,"AbilityAreaType":2,"AbilityTargetType":11,"StatusModifierType":2,"GrowUpLimitOnly":1,"EffectValue":250}]}}],"special_ability":null,"general_ability":null,"before_attack":null,"moving_attack":null,"one_time_reactive":null,"transform_of":null,"transform_into":null,"dedicated_weapon":{"id":25006,"name":"油滴天目茶器(固定)","description":""},"max_renovation":1,"voice_actor":"茜屋日海夏","flavor":["近江こそ、日本茶の発祥の地。\nうちはもっと近江茶を、有名に\nするんが夢なんです～。\n特におとなりさんの、\n宇治茶ぐらいにはなりたいーて\n思てるんですけどね～。","うちのお茶を飲んだ人が、\n「ほっこり」した言うから\nびっくりしたんですよ～。\nだって「ほっこり」は近江の\n方言で「疲れる」とか「うん\nざり」って意味なんですから～。","茶道に使うお茶っ葉は、いつも\n妹の近江八幡城に調達してもろ\nてるんです～。毎回お安く仕入\nれてくれるんで、ほんに重宝し\nてるんですよ～。"],"introduction":"近江と言えば、天下布武を掲げる織田信長が\n本拠地として選んだ、いわば不可侵なる聖域。\nそこに太閤秀吉さまは、甥の秀次さまのために\nこの私、八幡山城を築くんですから、\nそれはもう、そういう意味てことですね～。\n\nその証拠に、安土城下の商人さんや職人さんは、\nみーんな、うちの城下町に引っ越しさせられ、\n八幡山の経済は大きく発展していくことになります～。\n\n時代はもう、織田から豊臣へと傾いた……。\nきっと誰もが、そう思うたことでしょうね～。","welcome":"はじめまして、殿さん。\nヤワタではありませんよ。うちは八幡山城です～。\n凄腕の商人？　いえいえ、それは妹の方で、\nうちはしがない、ただの茶人ですよ～。","raw":{"CardID":3116,"ClassID":1400,"DedicatedWeaponID":25006,"Rarity":6,"VoiceID":1055,"AreaType":7,"FavoriteThings":2,"DotScale":1.0,"HealthCorrection":112,"AttackCorrection":116,"DefenseCorrection":120,"RegenerationCorrection":100,"GrowUpID":2,"GrowUpLimitType":999,"AbilityID":93116,"GimmickID":3116,"SpecialAttackID":3116,"CutInYCorrection":-200,"MaxRenovationCount":1,"Renovation1AbilityID":94116,"AutoProtect":1}}
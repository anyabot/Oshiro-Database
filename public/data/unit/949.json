めに。","welcome":"私は雑賀の暗部、雑賀城である。 \n歴史には光と影あり。仇敵を闇に屠り、自らも闇に朽ちる。 \nこの混沌の世に於いて、私が選んだ生き方だ。 \nすべては、あの方の未来を守るために――","raw":{"CardID":949,"ClassID":10800,"DedicatedWeaponID":13026,"Rarity":6,"Tokusei1":28,"VoiceID":934,"AreaType":7,"GainableYakumodama":60,"FavoriteThings":2,"DotScale":1.0,"HealthCorrection":100,"AttackCorrection":138,"DefenseCorrection":110,"RegenerationCorrection":100,"GrowUpID":7,"GrowUpLimitType":999,"AbilityID":9949,"AlwaysAbilityID":949,"GimmickID":949,"SpecialAttackID":949,"SpecialAbilityID":949,"OneTimeEffectReactiveType":1,"CutInYCorrection":-200,"MaxRenovationCount":1,"RenovationType":2,"Renovation1AbilityID":10949,"Renovation1SpecialAttackID":9949,"AutoProtect":1}}
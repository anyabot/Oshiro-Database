[{"AbilityType":1,"AbilityAreaType":1,"AbilityTargetType":2,"StatusModifierType":98,"Passive":1,"EffectValue":150},{"AbilityType":1,"AbilityAreaType":2,"AbilityTargetType":11,"StatusModifierType":602,"GrowUpLimitOnly":1,"EffectValue":65535}]},"class":{"ClassID":10900,"MaxLevel":125,"Cost":9,"InitialHealth":945,"MaxHealth":1900,"AttackType":100,"MaxTarget":1,"InitialAttack":60,"MaxAttack":230,"InitialDefense":35,"MaxDefense":141,"InitialRegeneration":10,"MaxRegeneration":35,"AttackSpeed":100,"AttackRange":280,"KiGainInterval":400,"KiBaseFeed":19,"MoveSpeedToBuilding":500,"WeaponType":15,"DefaultWeaponID":16000,"AttackWait":900,"ClassAbilityID":5028,"PotentialAbilityID":10900,"KiFeedLocationPlaceable":1,"AutoOrganizeGroup":10000}},"ability":{"id":63142,"name":"熱田の威光","description":"射程内の城娘の射程が80､回復が500上昇\n攻撃に自身の回復の80%の値を加算\n特殊能力中､射程内の敵の攻撃後の隙が40%延長","effects":[{"AbilityType":1,"AbilityAreaType":2,"AbilityTargetType":11,"StatusModifierType":52,"EffectValue":80},{"AbilityType":1,"AbilityAreaType":2,"AbilityTargetType":11,"StatusModifierType":202,"EffectValue":500},{"AbilityType":1,"AbilityAreaType":2,"AbilityTargetType":11,"StatusModifierType":433,"EffectValue":80},{"AbilityType":1,"AbilityAreaType":2,"AbilityTargetType":4,"StatusModifierType":73,"EffectValue":40}]}},"dedicated_weapon":{"id":16027,"name":"八雲神祓幣(固定)","description":""},"max_renovation":1,"voice_actor":"小原莉子","flavor":["私はあの信長を桶狭間に送り出 \nした御城だよ！　つまり、天下 \n人への道は清洲城から始まった \nんだ。そんな私が、殿にも同じ \n器量を感じたんだから期待して \nしまうのも当然のことだよ！","今川の名を聞くだけで、 \n私の胸の内は熱くなり、 \n魂が震えるのを感じるんだ！ \n怒りでも、もちろん \n怯えでもないこの気持ちを、 \n早くぶつけてやりたいよ！","私が刀を置いたのは、\n野望を捨てたからじゃないよ！\n自分の使命に相応しい得物に\n取り替えただけのことなんだ。"],"introduction":"わずか二千から三千名程度だったと言われている \n当時無名の織田信長軍が、雨中の強襲にて \n今川義元軍を打ち破った桶狭間の戦い。 \nあの歴史的な大勝利で、織田信長の名は \n一躍日の本中に轟いたんだ。 \n\nそして、その信長が出陣した御城こそ、この清洲城。 \nつまり私は、後の天下人である信長を \n送り出した御城ってことなんだよ。 \n\nその私が、今度は殿を天下統一へと送り出す。 \nそこに立ち塞がる最初の大きな障害も、 \n取り除けるだけの力は付けてきた。 \n行こう、殿。 \n歴史が動く瞬間は、もうすぐだよ！","welcome":"新たな力は夢を夢で終わらせないためのもの。 \nそれを阻む邪悪を打ち倒すためのもの。 \n天運すらも味方につけて、この清洲城が \n天下統一への道を切り拓いてみせるよ！","raw":{"CardID":3142,"ClassID":10900,"DedicatedWeaponID":16027,"Rarity":7,"Tokusei1":28,"VoiceID":1099,"AreaType":6,"FavoriteThings":1,"DotScale":1.0,"HealthCorrection":117,"AttackCorrection":126,"DefenseCorrection":117,"RegenerationCorrection":100,"GrowUpID":1,"GrowUpLimitType":999,"AbilityID":93142,"OrganizedAbilityID":3142,"AlwaysAbilityID":3142,"GimmickID":3142,"SpecialAbilityID":3142,"CutInYCorrection":-200,"MaxRenovationCount":1,"RenovationType":4,"Renovation1AbilityID":94142,"Renovation1GimmickID":4142,"DependenceCardId":16142,"AutoProtect":1}}
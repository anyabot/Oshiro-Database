ue":5,"LimitValue":200},{"AbilityType":19,"AbilityTypeDetail":3,"AbilityEffectDetail":8,"AbilityAreaType":3,"AbilityTargetType":504,"StatusModifierType":52,"Passive":1,"EffectValue":3,"LimitValue":20},{"AbilityType":19,"AbilityTypeDetail":3,"AbilityEffectDetail":8,"AbilityAreaType":3,"AbilityTargetType":504,"StatusModifierType":202,"Passive":1,"EffectValue":3,"LimitValue":20},{"AbilityType":1,"AbilityAreaType":2,"AbilityTargetType":11,"StatusModifierType":424,"EffectValue":30}]}}],"special_ability":null,"general_ability":null,"before_attack":null,"moving_attack":null,"one_time_reactive":null,"transform_of":null,"transform_into":null,"dedicated_weapon":{"id":25010,"name":"千利宇治献碗(固定)","description":""},"max_renovation":1,"voice_actor":"大室佳奈","flavor":["あぁ、馥郁たる覆い香……。\n渋すぎず旨味が舌に残る爽やか\nさ……。\nこれぞ究極の味わい！　至高の\n一杯！　やっぱり宇治茶しか\n勝たん……！","私、大きな池や湖が大好きで、\n見かけたら周りを巡ってみない\nと気が済まないんです。\nこの近くにも綺麗な池を見つけ\nたので、さっそく散歩に\n行きましょう！","やっと全部書き終わりました。\nああ、これは今度のお茶会の招\n待状をしたためていたんです。\nいえいえ、援軍要請の書状な\nわけないじゃないですか～、\nふふっ♪"],"introduction":"私、槇島城は山城国宇治近辺にあった、\n巨椋池に浮かぶ槇島に築かれた御城です。\n城主である真木島昭光さまは、\nあまり有名ではないかもしれませんが、\n衰えていく室町幕府最後の征夷大将軍\n足利義昭公に最後まで付き従った\n忠臣でもあるんですよ……って、え？\nあの御方って……何のことですか？\n\n私は別に兜の味方じゃないですよ！？\nとにかく私は、昭光さま譲りの忠義の心と、\n地元の名産、宇治茶への愛では誰にも負けません！\n\nというわけで！　さっそく殿のために、\nお茶会の席を設けさせていただきますね！","welcome":"はじめまして！\n山城国の宇治郷から参りました、槇島城です！\nお近づきの印に、お茶で一服いたしませんか？\n最高の宇治茶をご馳走しますので！","raw":{"CardID":3154,"ClassID":1400,"DedicatedWeaponID":25010,"Rarity":6,"VoiceID":1081,"AreaType":7,"GainableYakumodama":60,"FavoriteThings":1,"DotScale":1.0,"HealthCorrection":125,"AttackCorrection":111,"DefenseCorrection":112,"RegenerationCorrection":100,"GrowUpID":4,"GrowUpLimitType":999,"AbilityID":93154,"GimmickID":3154,"SpecialAttackID":3154,"CutInYCorrection":-200,"MaxRenovationCount":1,"Renovation1AbilityID":94154,"AutoProtect":1}}
e":9,"Passive":1,"EffectValue":6381312},{"AbilityType":6,"AbilityTypeDetail":14,"AbilityAreaType":1,"AbilityTargetType":310,"AbilityLocationType":9,"Passive":1,"EffectValue":6381312}]},"before_attack":null,"moving_attack":null,"one_time_reactive":null,"transform_of":null,"transform_into":null,"dedicated_weapon":null,"max_renovation":1,"voice_actor":"桑原由気","flavor":["くっ……時の将軍には一度しか\n泊まって頂けなかったでござる\nが……今度こそ、殿の御用達に\nなってみせるでござる！\n手始めに、\n夏いっぱいはお泊りを！","野洲川からお堀に引いている水\nは、伏流水といって、川から\n地下を流れているため、ろ過\nされて綺麗に澄んでいるのでご\nざる。だから近くに来るだけで\n涼しいのでござるよ！","茶道では、部屋の造りや装飾で\n涼しさを演出するのでござる。\nこれもまた、綺麗さびの極意で\nござるよ。心頭滅却すれば火も\nまた涼し！　でござるな！\n……え、違う？"],"introduction":"拙者、水口城は、\n徳川家光様の命によって建てられた\n由緒正しき将軍のお宿でござる！\n\nい、一度しか泊まってもらえなかったのは、\nもう言いっこなしでござるよ！\nそれよりも、拙者の夏の実力をとくと見るでござる！\n澄んだ水がお堀に流れるおかげで、\n泳いでよし、涼んでよし！\n拙者にお泊りいただければ、\n何処よりも快適にお過ごしいただけることを\nお約束するでござる。\n\nですので殿、なにとぞ、この夏は水口城へ！\nなにとぞ、なにとぞーっ！","welcome":"殿！　殿ーっ！\n夏はぜひ、拙者のところでご滞在くだされ！\n夏こそ水口城は本領発揮するのでござる！\n殿に最高の夏休みを提供するでござるよ！","raw":{"CardID":3126,"ClassID":100,"Rarity":6,"Tokusei1":2,"Tokusei2":22,"SkinGroupID":297,"VoiceID":1086,"AreaType":7,"GainableYakumodama":60,"DotScale":1.0,"HealthCorrection":118,"AttackCorrection":110,"DefenseCorrection":120,"RegenerationCorrection":100,"GrowUpID":1,"GrowUpLimitType":999,"AbilityID":93126,"GeneralAbilityID1":100001,"GimmickID":3126,"CutInYCorrection":-200,"MaxRenovationCount":1,"Renovation1AbilityID":94126,"Renovation1AlwaysAbilityID":1001,"Renovation1GimmickID":3126,"ExclusionVote":1,"AutoProtect":1}}